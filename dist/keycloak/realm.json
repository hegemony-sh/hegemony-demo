{
  "accessCodeLifespan": 60,
  "accessCodeLifespanLogin": 1800,
  "accessCodeLifespanUserAction": 300,
  "accessTokenLifespan": 300,
  "bruteForceProtected": true,
  "clients": [
    {
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*"
      },
      "baseUrl": "/",
      "clientId": "hegemony-ui",
      "defaultClientScopes": [
        "acr",
        "basic",
        "web-origins",
        "profile",
        "roles",
        "email"
      ],
      "description": "Public client of the web UI (authorization code with PKCE)",
      "directAccessGrantsEnabled": false,
      "enabled": true,
      "implicitFlowEnabled": false,
      "name": "Hegemony UI",
      "optionalClientScopes": [],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "config": {
            "access.token.claim": "true",
            "claim.name": "sub",
            "id.token.claim": "true",
            "jsonType.label": "String",
            "user.attribute": "id",
            "userinfo.token.claim": "true"
          },
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper"
        },
        {
          "config": {
            "access.token.claim": "true",
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          },
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper"
        },
        {
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.client.audience": "hegemony-api"
          },
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper"
        }
      ],
      "publicClient": true,
      "redirectUris": [
        "http://localhost:8080/*"
      ],
      "rootUrl": "http://localhost:8080",
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": true,
      "webOrigins": [
        "http://localhost:8080"
      ]
    },
    {
      "bearerOnly": true,
      "clientId": "hegemony-api",
      "description": "Bearer-only resource server: the audience the API checks",
      "directAccessGrantsEnabled": false,
      "enabled": true,
      "name": "Hegemony API",
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false
    }
  ],
  "defaultRole": {
    "composite": true,
    "name": "default-roles-hegemony"
  },
  "displayName": "Amphictyon Networks",
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "enabled": true,
  "failureFactor": 5,
  "groups": [
    {
      "name": "Amphictyon-Admins",
      "path": "/Amphictyon-Admins",
      "subGroups": []
    },
    {
      "name": "Amphictyon-Engineers",
      "path": "/Amphictyon-Engineers",
      "subGroups": []
    },
