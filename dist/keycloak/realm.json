  "loginTheme": "hegemony",
  "loginWithEmailAllowed": false,
  "maxDeltaTimeSeconds": 43200,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "offlineSessionIdleTimeout": 2592000,
  "passwordPolicy": "length(12) and maxLength(128) and notUsername and notEmail and passwordHistory(5)",
  "permanentLockout": false,
  "quickLoginCheckMilliSeconds": 1000,
  "realm": "hegemony",
  "registrationAllowed": false,
  "rememberMe": false,
  "resetPasswordAllowed": false,
  "roles": {
    "realm": [
      {
        "composite": false,
        "description": "Full administrative access",
        "name": "admin"
      },
      {
        "composite": false,
        "description": "Builds flows and runs them",
        "name": "editor"
      },
      {
        "composite": false,
        "description": "Runs flows and controls runs",
        "name": "operator"
      },
      {
        "composite": false,
        "description": "Approves or rejects approval requests",
        "name": "approver"
      },
      {
        "composite": false,
        "description": "Read-only access with audit visibility",
        "name": "auditor"
      },
      {
        "composite": false,
        "description": "Basic read-only access",
        "name": "viewer"
      },
      {
        "composite": true,
        "composites": {
          "realm": [
            "viewer"
          ]
        },
        "description": "Default roles of every user",
        "name": "default-roles-hegemony"
      }
    ]
  },
  "sslRequired": "external",
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
