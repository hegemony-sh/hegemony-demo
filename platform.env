#
# The platform release this demo runs: the one place its version is pinned,
# with the plugin wheels and the lab inventory that go with it. install.sh,
# deploy/compose/compose.sh, the tests and the release workflow all read this
# file. Plain KEY=value lines, so sh, Compose and Python can
# read it without a parser.
#
# When moving to another release, check the plugin wheels below against that
# release's pins (.github/plugin-pins.json): each plugin requires the exact SDK
# version of its own release.
HEGEMONY_PLATFORM_VERSION=1.0.0-rc.20

# Where the platform's Compose files come from: this repository at the tag
# v<version>. The images are ghcr.io/hegemony-sh/hegemony/<service>:<version>.
HEGEMONY_PLATFORM_REPO=https://github.com/hegemony-sh/hegemony.git

# Plugin wheels the demo adds on top of the platform images, as
# "<sha256>@<url>" pairs separated by spaces. The images already ship the core
# step, notification and secret plugins; these add every other plugin the four
# plugin repositories publish, so the demo has all of them installed: the Git
# and NetBox inventory providers, the shoutrrr and webhook notification
# presets, the 1Password secret backend and the asyncssh and scrapli device
# transports. scripts/latest_release.py lists the same set (WHEELS).
HEGEMONY_PLUGIN_WHEELS="1ddbcdb7ed8eb57dc6266ae09fb4fbe02826c13bdb6499c609fb830fdd127cec@https://github.com/hegemony-sh/hegemony-inventory-plugins/releases/download/v0.6.0/hegemony_inventory_git-0.6.0-py3-none-any.whl f36afeb84a7e05b2db0b3f66948e692160319319f8e447ad7666f5ae6e7e127c@https://github.com/hegemony-sh/hegemony-inventory-plugins/releases/download/v0.6.0/hegemony_inventory_netbox-0.6.0-py3-none-any.whl 1ebbe23673e03d4b20ba4993162243a5f40c988a8ed97a088e2a2d0547954e63@https://github.com/hegemony-sh/hegemony-notification-plugins/releases/download/v0.3.3/hegemony_notification_shoutrrr_presets-0.3.3-py3-none-any.whl be032779a7700e2da668ac59afbc6b70c8361f085c29c6a6789da7a064f9b87f@https://github.com/hegemony-sh/hegemony-notification-plugins/releases/download/v0.3.3/hegemony_notification_webhook_presets-0.3.3-py3-none-any.whl 634a432cf3a9e5c7add365cba38c4e0fdcd310c5e5400ddea55674c16d61970c@https://github.com/hegemony-sh/hegemony-secret-plugins/releases/download/v0.3.6/hegemony_secret_1password-0.3.6-py3-none-any.whl cf7d73e932fc89c51365a239721a03ab789a45fa70c25eb087aa3eb624e58681@https://github.com/hegemony-sh/hegemony-step-plugins/releases/download/v0.53.1/hegemony_transport_asyncssh-0.53.1-py3-none-any.whl 13691216f1bc575407ec6a66edd3e8b7ff765fbdc6b23b44c82ff20f83ca3bee@https://github.com/hegemony-sh/hegemony-step-plugins/releases/download/v0.53.1/hegemony_transport_scrapli-0.53.1-py3-none-any.whl"

# The lab's inventory: a release tag of this repository's inventory/ folder.
# deploy/lab/fetch-inventory.sh copies it into deploy/lab/inventory/, the
# lab's Gitea seed commits it to netops/inventory, and the Git inventory
# provider reads it from there. CI checks the tag against spec/basic.yaml
# (demo-gen --check-inventory).
HEGEMONY_INVENTORY_REPO=https://github.com/hegemony-sh/hegemony-demo-inventory.git
HEGEMONY_INVENTORY_REF=v2026.11.09
