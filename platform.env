#
# The platform release this demo runs: the one place its version is pinned.
# install.sh, deploy/compose/compose.sh, the tests and the release workflow
# all read this file. Plain KEY=value lines, so sh, Compose and Python can
# read it without a parser.
#
# When moving to another release, check the plugin wheel below against that
# release's pins (.github/plugin-pins.json and the hegemony-inventory-sdk range
# in its pyproject.toml): the Git inventory plugin requires an exact SDK version.
HEGEMONY_PLATFORM_VERSION=1.0.0

# Where the platform's Compose files come from: this repository at the tag
# v<version>. The images are ghcr.io/hegemony-sh/hegemony/<service>:<version>.
HEGEMONY_PLATFORM_REPO=https://github.com/hegemony-sh/hegemony.git

# Plugin wheels the demo adds on top of the platform images, as
# "<sha256>@<url>" pairs separated by spaces. The images already ship the step,
# notification and secret plugins the stories use; the git inventory plugin is
# the one extra.
HEGEMONY_PLUGIN_WHEELS="846415081b5d856adf1a69d9059e0c163b83582fbd870cd64f6bd9a0f99e8e8f@https://github.com/hegemony-sh/hegemony-inventory-plugins/releases/download/v0.5.0/hegemony_inventory_git-0.5.0-py3-none-any.whl"
