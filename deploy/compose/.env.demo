#
# Settings of the demo stack. DEMO ONLY: the fixed values here are published
# demo values for a stack that listens on loopback only. The login password
# of the demo users and of the Keycloak console is not here: install.sh
# generates it into deploy/compose/.local/demo.env on your machine.
#
# compose.sh passes, in order: this file, dist/demo.env (generated from the
# spec), deploy/compose/.local/demo.env (generated passwords). The platform
# image tag comes from platform.env at the repository root.

# --------------------------------------------------------------------- core
HEGEMONY_ENVIRONMENT=dev
HEGEMONY_LOG_LEVEL=INFO
HEGEMONY_STACK_NAME=hegemony-demo

POSTGRES_USER=hegemony
POSTGRES_PASSWORD=hegemony
POSTGRES_DB=hegemony
HEGEMONY_DATABASE_URL=postgresql+asyncpg://hegemony:hegemony@postgres-app:5432/hegemony

HEGEMONY_TEMPORAL_HOST=temporal:7233
HEGEMONY_TEMPORAL_NAMESPACE=default
HEGEMONY_TEMPORAL_TASK_QUEUE=hegemony-tasks
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=temporal
TEMPORAL_DB_NAME=temporal
TEMPORAL_UI_PORT=8088

HEGEMONY_INTERNAL_API_TOKEN=demo-internal-token-not-for-production

# ----------------------------------------------------------------------- UI
# Loopback only. The UI must be opened at exactly this URL.
HEGEMONY_UI_PUBLIC_URL=http://localhost:8080
UI_BIND_ADDRESS=127.0.0.1
UI_PORT=8080

# ----------------------------------------------------------- Keycloak / OIDC
KEYCLOAK_ADMIN=admin
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_START_MODE=start-dev
KEYCLOAK_BIND_ADDRESS=127.0.0.1
KC_PROXY_HEADERS=xforwarded
KC_HOSTNAME_STRICT=false
KC_REALM_NAME=hegemony
HEGEMONY_KEYCLOAK_ISSUER=http://keycloak:8081/realms/hegemony
HEGEMONY_KEYCLOAK_PUBLIC_ISSUER=http://localhost:8081/realms/hegemony
HEGEMONY_KEYCLOAK_AUDIENCE=hegemony-api
HEGEMONY_AUTH_DISABLED=false
# The platform default: a user with the admin role sets up a one-time code at
# first login. The stories need no admin; see docs/walkthrough.md.
HEGEMONY_ADMIN_MFA_REQUIRED=true
# Keycloak groups grant the organization roles the bundles map them to.
HEGEMONY_ORG_IDP_SYNC=true

# -------------------------------------------------------------- object store
HEGEMONY_S3_INTERNAL_ENABLED=true
HEGEMONY_S3_BIND_ADDRESS=127.0.0.1
HEGEMONY_S3_ENDPOINT_URL=http://objectstore:9000
HEGEMONY_S3_ACCESS_KEY_ID=objectstoreadmin
HEGEMONY_S3_SECRET_ACCESS_KEY=objectstoreadmin
HEGEMONY_S3_BUCKET=hegemony
HEGEMONY_S3_REGION=us-east-1
HEGEMONY_S3_EXTERNAL_URL=http://localhost:9000

# ---------------------------------------------------------- internal OpenBao
HEGEMONY_OPENBAO_INTERNAL_ENABLED=true
OPENBAO_RECOVERY_SHARES=1
OPENBAO_RECOVERY_THRESHOLD=1
OPENBAO_NETWORK_SUBNET=172.29.240.0/24
OPENBAO_BOUND_CIDRS=172.29.240.0/24

# ------------------------------------------- container sandbox (dind) network
# install.sh sets DOCKER_GID from the host; 999 is the common default.
DOCKER_GID=999
# The default network. The simulated routers take fixed addresses in it
# (dist/demo.env), below the dynamic range, so keep them inside SUBNET and
# outside IP_RANGE if you change these.
HEGEMONY_COMPOSE_SUBNET=172.28.102.0/24
HEGEMONY_COMPOSE_GATEWAY=172.28.102.1
HEGEMONY_COMPOSE_IP_RANGE=172.28.102.128/25
HEGEMONY_COMPOSE_SUBNET_V6=fd00:28:102::/64
HEGEMONY_COMPOSE_GATEWAY_V6=fd00:28:102::1
HEGEMONY_COMPOSE_IP_RANGE_V6=fd00:28:102::1:0/112
HEGEMONY_DIND_FIXED_CIDR_V6=fd00:d00d:102::/64
HEGEMONY_DIND_IPV4=172.28.102.10
HEGEMONY_DIND_IPV6=fd00:28:102::10
HEGEMONY_SANDBOX_TOKEN=hegemony-demo-sandbox
HEGEMONY_CONTAINER_EGRESS_NFLOG_GROUP=32
HEGEMONY_CONTAINER_EGRESS_NFLOG_FILE=/var/log/hegemony-egress/nflog.json
HEGEMONY_SHARED_WORKSPACE_VOLUME=hegemony-prod-shared-workspaces

# ------------------------------------------------------- instance bootstrap
# The API imports dist/bundles/ once, into a fresh database.
HEGEMONY_BOOTSTRAP_ENABLED=true
# Schedules import disabled; the one schedule the demo ships is off anyway.
HEGEMONY_BOOTSTRAP_ENABLE_SCHEDULES=false

# ------------------------------------------------------------ demo services
MAILPIT_BIND_ADDRESS=127.0.0.1
MAILPIT_UI_PORT=8025
